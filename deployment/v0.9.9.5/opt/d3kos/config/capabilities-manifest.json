{
  "manifest_version": "1.0",
  "features": {
    "surround_view": {
      "display_name": "3D Surround View",
      "description": "360° camera grid view with forward WebRTC panel and SVG range rings",
      "requires": {
        "pi_gen_min": 4,
        "ram_mb_min": 2048
      },
      "operator_override": false
    },
    "forward_watch": {
      "display_name": "Forward Watch (AI Object Detection)",
      "description": "YOLOv8n ONNX object detection on forward camera stream",
      "requires": {
        "pi_gen_min": 4,
        "ram_mb_min": 2048
      },
      "operator_override": false
    },
    "safehelm": {
      "display_name": "SafeHelm (COLREGs Decision Support)",
      "description": "Real-time COLREGs Rule guidance and collision risk assessment",
      "requires": {
        "pi_gen_min": 4,
        "ram_mb_min": 2048
      },
      "operator_override": false
    },
    "marine_vision_ai": {
      "display_name": "Marine Vision AI (Fish Detector)",
      "description": "AI-assisted fish and wildlife detection from camera feeds — requires AI accelerator",
      "requires": {
        "pi_gen_min": 4,
        "ram_mb_min": 3500,
        "accelerator_any": true,
        "accelerator_class_any": ["hailo-8l", "hailo-8", "coral-usb", "coral-usb-mini"]
      },
      "operator_override": false
    }
  }
}
