[Unit]
Description=d3kOS Hybrid Voice Assistant
Documentation=https://github.com/d3kos/d3kos
After=network.target sound.target d3kos-tier.service
Wants=d3kos-tier.service
# BUG-143: skip cleanly when Vosk model not installed (lab Pi, boat Pi before model deploy)
ConditionPathExists=/opt/d3kos/models/vosk/vosk-model-small-en-us-0.15

[Service]
Type=simple
User=d3kos
Group=d3kos
WorkingDirectory=/opt/d3kos/services/voice

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="HOME=/home/d3kos"

# Tier gate (BUG-102) — ExecCondition skips the unit cleanly at Tier 0; see d3kos-camera-stream.service
ExecCondition=/bin/bash -c 'for i in 1 2 3 4 5; do curl -sf http://localhost:8093/tier/feature/voice_assistant 2>/dev/null | jq -e ".enabled == true" >/dev/null 2>&1 && exit 0; sleep 3; done; exit 1'

ExecStart=/usr/bin/python3 /opt/d3kos/services/voice/voice-assistant-hybrid.py --auto-start

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=d3kos-voice

# Resource limits
Nice=-5
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
