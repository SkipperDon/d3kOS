[Unit]
Description=d3kOS Fish Detector Service - Marine Vision Phase 2
After=network.target d3kos-tier.service d3kos-camera-stream.service
Wants=d3kos-tier.service d3kos-camera-stream.service
# BUG-142: skip cleanly when ONNX model not installed (lab Pi, fresh image before model deploy)
ConditionPathExists=/opt/d3kos/models/marine-vision/fish_detector.onnx

[Service]
Type=simple
User=d3kos
WorkingDirectory=/opt/d3kos/services/marine-vision
# Tier gate (BUG-102, fail-open fix BUG-136). Same logic as d3kos-camera-stream.service.
# Fail-open: tier API unreachable → allow. Only block on explicit enabled:false.
ExecCondition=/bin/bash -c 'R=$(curl -sf --max-time 15 http://localhost:8093/tier/feature/camera 2>/dev/null); RC=$?; if [ $RC -ne 0 ] || [ -z "$R" ]; then exit 0; fi; echo "$R" | jq -e ".enabled == false" >/dev/null 2>&1 && exit 1; exit 0'
ExecStart=/usr/bin/python3 /opt/d3kos/services/marine-vision/fish_detector.py
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
