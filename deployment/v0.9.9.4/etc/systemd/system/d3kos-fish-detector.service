[Unit]
Description=d3kOS Fish Detector Service - Marine Vision Phase 2
After=network.target d3kos-camera-stream.service
Wants=d3kos-camera-stream.service

[Service]
Type=simple
User=d3kos
WorkingDirectory=/opt/d3kos/services/marine-vision
# Tier check — retry up to 5 times (tier API may not be ready at boot)
ExecStartPre=/bin/bash -c 'for i in 1 2 3 4 5; do result=$(curl -sf http://localhost:8093/tier/feature/camera 2>/dev/null); if echo "$result" | jq -e ".enabled == true" >/dev/null 2>&1; then exit 0; fi; sleep 3; done; exit 1'
ExecStart=/usr/bin/python3 /opt/d3kos/services/marine-vision/fish_detector.py
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
