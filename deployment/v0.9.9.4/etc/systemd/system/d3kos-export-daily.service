[Unit]
Description=d3kOS Daily Scheduled Export
After=network-online.target d3kos-export-manager.service d3kos-tier-api.service d3kos-export-manager.service
Wants=network-online.target
# BUG-145: skip cleanly when export script not present
ConditionPathExists=/opt/d3kos/scripts/export-daily.sh

[Service]
Type=oneshot
User=d3kos
ExecStart=/opt/d3kos/scripts/export-daily.sh
StandardOutput=journal
StandardError=journal

# No [Install] section - triggered by timer only
