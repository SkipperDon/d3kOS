[Unit]
Description=d3kOS Live Session Service — WebRTC tunnel for mobile app
Documentation=https://atmyboat.com
After=network-online.target d3kos-cloud-agent.service
Wants=network-online.target
# BUG-102: an unpaired / Tier-0 device has neither file. Skip cleanly instead of exit(1) + restart loop.
ConditionPathExists=/opt/d3kos/config/cloud-config.json
ConditionPathExists=/opt/d3kos/config/device-token.json

[Service]
Type=simple
User=d3kos
WorkingDirectory=/opt/d3kos/services/live
ExecStart=/usr/bin/python3 /opt/d3kos/services/live/live_session.py
Restart=on-failure
RestartSec=10
# BUG-141: file-append logging fails if log owned by root; use journal like all other services
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
